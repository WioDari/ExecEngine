NAME="Prolog (GNU v$VERSION)"
VERSIONS="1.5.0"
SOURCE_FILE="script.pro"
COMPILED_FILE="script"
COMPILE_CMD="printf ':- initialization(main).\n' > ?/__execengine_init.pro && PATH=/usr/local/prolog-$VERSION/bin:$PATH /usr/local/prolog-$VERSION/bin/gplc $args --no-top-level -o $COMPILED_FILE ?/$SOURCE_FILE ?/__execengine_init.pro"
RUN_CMD="./$COMPILED_FILE"
