[Unit]
Description=ExecEngine execution worker
Requires=isolate.service
After=isolate.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/app
ExecStart=/usr/local/sbin/execengine-worker-entrypoint
Restart=on-failure
RestartSec=5s
TimeoutStopSec=85s
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
